# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database ----------
# Local MongoDB (or the one started by `docker compose up -d`):
MONGO_URI=mongodb://127.0.0.1:27017/smart_city
# MongoDB Atlas (cloud) looks like this instead:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_city?retryWrites=true&w=majority

# ---------- Auth ----------
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# ---------- CORS ----------
# Address of the React app. Several origins can be separated by commas.
CLIENT_URL=http://localhost:5173

# ---------- First admin account (used by `npm run seed`) ----------
ADMIN_NAME=City Admin
ADMIN_EMAIL=admin@smartcity.local
ADMIN_PASSWORD=ChangeMe@123
